  "cards": [
    {
      "dot": "amber",
      "title": "Spending happens in exactly one place",
      "items": [
        "The workflow runs every search — one cheap, no-scrape call per sub-question, deduped by query.",
        "Every agent carries web_search denied, so no agent loop can spend around the meter.",
        "Both calls need the net-search grant; without it the run refuses by name.",
        "workflows/deep-research.ts:91 and 145"
      ]
    },
    {
      "dot": "rose",
      "title": "The meter stops before it overspends",
      "items": [
        "creditBudget (default 20; a search is roughly 2) is checked before each call.",
        "Spent means the remaining questions work from the pool already judged.",
        "The result names credit-budget, so a short run explains itself.",
        "workflows/deep-research.ts:146"
      ]
    },
    {
      "dot": "cyan",
      "title": "Judged, not asked",
      "items": [
        "A sys1 judge head rules each finding supported or unconfirmed on the scraped page content.",
        "The judge may downgrade a finding, never upgrade one — the one-way rule.",
        "An unreachable judge leaves the finding unconfirmed rather than passing it.",
        "workflows/deep-research.ts:218"
      ]
    },
    {
      "dot": "violet",
      "title": "Stops on honest grounds",
      "items": [
        "Coverage: the reflector returns no next questions.",
        "Plateau: a round added no new sources.",
        "Depth: the round cap, or the credit budget, ran out.",
        "Every stop reason lands in the result and the coverage map.",
        "workflows/deep-research.ts:277"
      ]
    }
  ]
