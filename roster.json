{
  "version": 1,
  "router": {
    "port": 8300,
    "localToken": "local-auto-router"
  },
  "typesafe": {
    "apiKeyEnv": "TYPESAFE_API_KEY",
    "model": "jev-1.13.0",
    "ttlHours": 6
  },
  "allowPayg": false,
  "providers": {
    "deepseek": {
      "providerName": "DeepSeek",
      "templateId": "deepseek",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "billing": "payg",
      "models": [
        "deepseek-flash",
        "deepseek-v4-pro"
      ],
      "featured": [],
      "id": "deepseek",
      "enabled": true,
      "hasKey": true
    },
    "xiaomi-mimo": {
      "providerName": "Xiaomi MiMo",
      "templateId": "xiaomi-mimo",
      "baseUrl": "https://token-plan-sgp.xiaomimimo.com/v1",
      "apiKeyEnv": "XIAOMI_MIMO_API_KEY",
      "billing": "plan",
      "models": [
        "mimo-v2.6-pro",
        "mimo-v2.6-flash",
        "mimo-v2.5-pro",
        "mimo-v2.5"
      ],
      "featured": [
        "mimo-v2.6-pro",
        "mimo-v2.6-flash"
      ],
      "id": "xiaomi-mimo",
      "enabled": true,
      "hasKey": true
    },
    "token-plan": {
      "providerName": "Token Plan (Alibaba)",
      "baseUrl": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
      "apiKeyEnv": "TOKEN_PLAN_API_KEY",
      "billing": "plan",
      "models": [
        "qwen3.8-flash"
      ],
      "featured": [
        "qwen3.8-flash"
      ],
      "id": "token-plan",
      "enabled": true,
      "hasKey": true
    },
    "stepfun": {
      "providerName": "StepFun Step Plan",
      "baseUrl": "https://api.stepfun.ai/step_plan/v1",
      "apiKeyEnv": "STEPFUN_API_KEY",
      "billing": "plan",
      "models": [
        "step-3.7-flash",
        "step-3.5-flash",
        "step-3.5-flash-2603",
        "step-5-preview"
      ],
      "featured": [
        "step-3.7-flash",
        "step-3.5-flash",
        "step-3.5-flash-2603",
        "step-5-preview"
      ],
      "id": "stepfun",
      "enabled": true,
      "hasKey": true
    },
    "zai-coding-plan": {
      "providerName": "Zai Coding Plan",
      "baseUrl": "https://api.z.ai/api/coding/paas/v4",
      "apiKeyEnv": "ZAI_CODING_API_KEY",
      "billing": "plan",
      "routerOnly": true,
      "models": [],
      "id": "zai-coding-plan",
      "enabled": true,
      "hasKey": true
    }
  },
  "omniModel": [
    "xiaomi-mimo/mimo-v2.6-pro",
    "zai-coding-plan/GLM-5.3-Flash",
    "stepfun/step-5-preview"
  ],
  "wideModel": [
    "xiaomi-mimo/mimo-v2.6-pro",
    "zai-coding-plan/GLM-5.3-Flash",
    "stepfun/step-3.7-flash"
  ],
  "tiers": {
    "quick": {
      "target": "token-plan/qwen3.8-flash",
      "fallbacks": [
        "stepfun/step-3.7-flash",
        "zai-coding-plan/GLM-5.3-Flash"
      ]
    },
    "standard_code": {
      "target": "token-plan/qwen3.8-flash",
      "fallbacks": [
        "zai-coding-plan/GLM-5.3-Flash",
        "stepfun/step-3.7-flash"
      ]
    },
    "hard": {
      "target": "zai-coding-plan/GLM-5.3-Flash",
      "fallbacks": [
        "xiaomi-mimo/mimo-v2.6-pro",
        "stepfun/step-5-preview"
      ]
    },
    "prose": {
      "target": "xiaomi-mimo/mimo-v2.6-flash",
      "fallbacks": [
        "zai-coding-plan/GLM-5.3-Flash",
        "token-plan/qwen3.8-flash"
      ]
    },
    "deep_context": {
      "target": "stepfun/step-5-preview",
      "fallbacks": [
        "zai-coding-plan/GLM-5.3-Flash",
        "xiaomi-mimo/mimo-v2.6-pro"
      ]
    }
  },
  "profiles": {
    "quick": {
      "workload": "quick"
    },
    "code": {
      "workload": "standard_code"
    },
    "hard": {
      "workload": "hard"
    },
    "prose": {
      "workload": "prose"
    },
    "long-context": {
      "workload": "deep_context"
    },
    "vision": {
      "use": "omniModel"
    },
    "mixture": {
      "use": "mixture"
    },
    "deep": {
      "workload": "hard",
      "thinking": "deep"
    },
    "bulk": {
      "workload": "quick",
      "thinking": "off"
    }
  },
  "mixture": {
    "proposers": [
      "zai-coding-plan/GLM-5.3-Flash",
      "xiaomi-mimo/mimo-v2.6-pro",
      "stepfun/step-5-preview"
    ],
    "aggregator": [
      "zai-coding-plan/GLM-5.3-Flash",
      "xiaomi-mimo/mimo-v2.6-pro",
      "stepfun/step-5-preview"
    ],
    "proposerTimeoutMs": 240000
  },
  "routing": {
    "wideChars": 1000000,
    "minConfidence": 0.6,
    "workflowMinConfidence": 0.4,
    "defaultWorkload": "standard_code"
  },
  "workflows": {
    "registry": {
      "review-sweep": {
        "taskArg": "task",
        "shape": "reviewing changes — a diff, a PR, or modified files — where findings must be confirmed before anyone acts on them",
        "defaults": {
          "base": ""
        }
      },
      "bug-hunt": {
        "taskArg": "symptom",
        "shape": "something is broken or misbehaving and the request is to find the root cause, not to fix it yet"
      },
      "migration": {
        "taskArg": "task",
        "shape": "moving code from one approach, library, or pattern to another across a repository"
      },
      "research-report": {
        "taskArg": "topic",
        "shape": "researching a topic and producing a written report or state-of-the-landscape with sources"
      },
      "deep-dive": {
        "taskArg": "scope",
        "shape": "understanding, explaining, or assessing how a system works — architecture questions, onboarding, improvement shortlists"
      },
      "coverage-push": {
        "taskArg": "target",
        "shape": "adding tests or improving test coverage for a module or a codebase"
      },
      "content-production": {
        "taskArg": "brief",
        "shape": "producing written content from a brief — a report, article, deck content, or long-form document"
      },
      "decision-memo": {
        "taskArg": "question",
        "shape": "a decision between plausible options — architecture choices, build-vs-buy, strategy calls — where the user wants a reasoned recommendation"
      },
      "postmortem": {
        "taskArg": "incident",
        "shape": "an incident, outage, or data problem happened and the request is to understand and write up what occurred and why"
      },
      "adversarial-solve": {
        "taskArg": "task",
        "shape": "a problem with several plausible solutions — or one naming multiple approaches like A vs B, or asking to build/try more than one — where competing independent attempts and a judge picking the best beats one opinion"
      }
    }
  },
  "manualModelRules": [
    {
      "modelId": "mimo-v2.6-pro",
      "config": {
        "enabled": true,
        "properties": {
          "contextWindow": 1000000,
          "supportsJsonSchemaOutput": false,
          "supportsNativeWebSearch": false,
          "supportsMidConversationSystem": false,
          "inputFormat": {
            "supportsImage": true,
            "supportsVideo": true,
            "supportsPdf": false
          }
        },
        "optionSpecs": {
          "reasoningLevel": {
            "values": [
              "disabled",
              "enabled"
            ],
            "map": "{\n  \"thinking\": {\n    \"type\": reasoningLevel == \"enabled\" ? \"enabled\" : \"disabled\"\n  }\n}"
          },
          "maxOutputTokens": {
            "max": 131072
          }
        }
      },
      "providerId": "xiaomi-mimo"
    },
    {
      "modelId": "mimo-v2.6-flash",
      "config": {
        "enabled": true,
        "properties": {
          "contextWindow": 1000000,
          "supportsJsonSchemaOutput": false,
          "supportsNativeWebSearch": false,
          "supportsMidConversationSystem": false,
          "inputFormat": {
            "supportsImage": true,
            "supportsVideo": true,
            "supportsPdf": false
          }
        },
        "optionSpecs": {
          "reasoningLevel": {
            "values": [
              "disabled",
              "enabled"
            ],
            "map": "{\n  \"thinking\": {\n    \"type\": reasoningLevel == \"enabled\" ? \"enabled\" : \"disabled\"\n  }\n}"
          },
          "maxOutputTokens": {
            "max": 131072
          }
        }
      },
      "providerId": "xiaomi-mimo"
    }
  ],
  "judge": {
    "note": "who answers the four routing questions. typesafe = TypeSafe Jev (default). fastino = GLiNER2.5 encoder via api.fastino.ai, always. cascade = GLiNER2.5 first, TypeSafe escalates when it is cold, erroring, or below the confidence gates. The mixture's best-answer judge stays TypeSafe either way.",
    "mode": "cascade",
    "fastino": {
      "model": "fastino/gliner2.5-multi-v1",
      "apiKeyEnv": "FASTINO_API_KEY",
      "timeoutMs": 2500,
      "keepWarm": true
    }
  },
  "kit": {
    "edition": "agnostic",
    "defaultPort": 8300
  }
}
