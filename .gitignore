# Machine-local, never committed
roster.local.json
.env

# The engine resolves the plane as a file: dependency on lib/workflow, so the
# link and its lockfile are install-time artifacts, not source.
node_modules/
package-lock.json

# The runtime copy is generated by `kit apply` from router/
router/node_modules/
router/logs/
*.bak-kit*
.DS_Store
router/package-lock.json

# NOTE: roster.json IS committed (it holds apiKeyEnv references, never raw
# keys). If you ever put a raw "apiKey" in the roster, `kit apply` warns and
# you must add roster.json here.

# local tool caches — never committed
.archify/

# archify run receipts — the candidates and their HTML renders are the
# committed artifacts (docs/architecture/*.candidate.json + *.html)
docs/architecture/*.finalize*.json
docs/architecture/*.delivery.json
docs/architecture/*.browser-check.json

# electron build output
app/dist/
